# Runtime
UBS_PORT=8777
UBS_HOST=127.0.0.1
# Where approvals, executions and the audit log are stored (mode 0700).
UBS_DATA_DIR=~/.utcp-browser-session
# Override the generated runtime token (leave empty to let the runtime create one).
UBS_TOKEN=
# Directory with the built dashboard (defaults to <repo>/dashboard/dist).
UBS_DASHBOARD_DIR=
UBS_LOG_LEVEL=info

# Client side (UTCP provider, CLI, benchmarks)
UTCP_BROWSER_SESSION_TOKEN=

# Fixture website used by the tests
SITE_PORT=8788
